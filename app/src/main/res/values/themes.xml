<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Velo theme — dark by default, cobalt inspired -->
    <style name="Theme.Velo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/velo_accent</item>
        <item name="colorOnPrimary">@color/velo_text</item>
        <item name="android:colorBackground">@color/velo_bg</item>
        <item name="colorSurface">@color/velo_surface</item>
        <item name="colorOnSurface">@color/velo_text</item>
        <item name="colorError">@color/velo_error</item>
        <item name="android:statusBarColor">@color/velo_bg</item>
        <item name="android:navigationBarColor">@color/velo_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Transparent theme for ShareActivity — shows app behind as dim layer -->
    <style name="Theme.Velo.BottomSheet" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorPrimary">@color/velo_accent</item>
        <item name="colorSurface">@color/velo_surface</item>
        <item name="colorOnSurface">@color/velo_text</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Velo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/velo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_velo_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Velo</item>
    </style>

</resources>
